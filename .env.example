# Copy to .env and adjust. All values shown are the defaults.

# Vault to work on (any folder; each vault has its own WIKI.md).
WIKI_VAULT_DIR=examples/vault
# Source packets. Empty = "inbox" next to the vault (<vault>/../inbox).
WIKI_INBOX_DIR=
# Language of all non-source pages (source pages keep their own language).
WIKI_LANGUAGE=en

OLLAMA_BASE_URL=http://localhost:11434
NUM_CTX=32768

# Model per stage role, as backend:model.
MODEL_EXTRACT=ollama:qwen3:14b
MODEL_RESOLVE=ollama:qwen3:14b
MODEL_PATCH=ollama:qwen3:14b
MODEL_SUMMARY=ollama:qwen3:14b
MODEL_QUERY=ollama:qwen3:14b
# MODEL_JUDGE=

# Thinking per role (qwen3), 1/0. Resolve thinks by default (M0: no false merges
# only with thinking); patch thinking on vs off is decided in the M4 bench.
THINK_RESOLVE=1
THINK_EXTRACT=0
THINK_PATCH=0
THINK_SUMMARY=0

# Every model call is bounded: output tokens and seconds (M4: an uncapped call
# looped for 9 hours). A cut-off answer counts as a failed call and is retried once.
MAX_OUTPUT_TOKENS=8192
CALL_TIMEOUT_S=600
