        <mxCell id="e_s2" value="yes" style="endArrow=block;html=1;rounded=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g2" target="stop2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="sp" value="&lt;b&gt;source page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;upstream summary.md, else 1 summary call;&lt;br&gt;keeps the source&#x27;s language&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="pt" value="&lt;b&gt;3d/3e patch + apply — one page at a time&lt;/b&gt;" style="swimlane;html=1;startSize=26;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="340" height="420" as="geometry" /></mxCell>
        <mxCell id="pt1" value="&lt;b&gt;patch call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;current page (or skeleton) + new claims&lt;br&gt;+ ≤ 40 linkable pages → {lead, ops[append|replace]}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pt"><mxGeometry x="20" y="36" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="pt2" value="&lt;b&gt;edits.apply&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;split at ## — untouched sections byte-identical&lt;br&gt;unknown links → text · missing citation → added&lt;br&gt;lossy replace / shrink &amp;lt; 60 % → rejected&lt;br&gt;lead losing links → old lead kept&lt;br&gt;final: no link of the old body lost (L-4)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="pt"><mxGeometry x="20" y="116" width="300" height="105" as="geometry" /></mxCell>
        <mxCell id="pt3" value="&lt;b&gt;fixable rejection?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pt"><mxGeometry x="85" y="236" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="pt4" value="&lt;b&gt;ask once more&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;same prompt + the reasons&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pt"><mxGeometry x="20" y="322" width="140" height="45" as="geometry" /></mxCell>
        <mxCell id="pt5" value="&lt;b&gt;front matter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sources + this source, updated,&lt;br&gt;aliases unless another page owns them&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="pt"><mxGeometry x="160" y="322" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="e_pt0" value="proposal" style="endArrow=block;html=1;" edge="1" parent="pt" source="pt1" target="pt2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pt1" value="" style="endArrow=block;html=1;" edge="1" parent="pt" source="pt2" target="pt3"><mxGeometry relative="1" as="geometry" /></mxCell>
