  <diagram id="run" name="4 Integrate run (as built)">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t4" value="&lt;b&gt;One integrate run, as built (M3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;mneme-wiki integrate &amp;lt;packet&amp;gt;… — integrate.py:123. Every write goes into an in-memory Workspace; the vault changes only at the very end, in one git commit.&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="50" as="geometry" /></mxCell>
        <mxCell id="lgc" value="&lt;b&gt;code (deterministic)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="20" width="160" height="26" as="geometry" /></mxCell>
        <mxCell id="lgm" value="&lt;b&gt;model call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ollama, model per role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1250" y="52" width="160" height="34" as="geometry" /></mxCell>
        <mxCell id="lgg" value="&lt;b&gt;gate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1420" y="20" width="120" height="26" as="geometry" /></mxCell>
        <mxCell id="lgs" value="&lt;b&gt;stop: nothing written&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1420" y="52" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="lgf" value="&lt;b&gt;files&lt;/b&gt;" style="shape=folder;tabWidth=40;tabHeight=12;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="92" width="160" height="30" as="geometry" /></mxCell>
        <mxCell id="in" value="&lt;b&gt;source packet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;inbox/&amp;lt;name&amp;gt;/ or a path&lt;br&gt;source.md, source.meta.json&lt;br&gt;summary.md, toc.json (optional)&lt;/font&gt;" style="shape=folder;tabWidth=40;tabHeight=12;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="ld" value="&lt;b&gt;load + check packet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;packet.py:62 — title, source_type, origin, date&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="g1" value="&lt;b&gt;vault is a git repo&lt;br&gt;and clean?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100" y="275" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="g2" value="&lt;b&gt;origin already&lt;br&gt;integrated?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="ws" value="&lt;b&gt;Workspace(vault)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;workspace.py — overlay: writes collected in memory,&lt;br&gt;reads see them; same path/case checks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="485" width="260" height="55" as="geometry" /></mxCell>
        <mxCell id="ck" value="&lt;b&gt;chunk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;packet.py:119 — at headings, ≤ 500 words;&lt;br&gt;heading = locator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="565" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="ex" value="&lt;b&gt;3a extract — 1 call per chunk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;subjects: name, kind, aliases, description, claims&lt;br&gt;prompt lists ≤ 40 known pages for this chunk;&lt;br&gt;output validated + clipped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="260" height="75" as="geometry" /></mxCell>
        <mxCell id="mg" value="&lt;b&gt;merge in source&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;same normalised name/alias → one subject&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="260" height="45" as="geometry" /></mxCell>
        <mxCell id="rs" value="&lt;b&gt;3b resolve — per subject&lt;/b&gt;" style="swimlane;html=1;startSize=26;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="260" height="235" as="geometry" /></mxCell>
        <mxCell id="rs1" value="&lt;b&gt;exact name / alias&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;vs existing pages + this source&#x27;s new subjects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="rs"><mxGeometry x="10" y="34" width="240" height="45" as="geometry" /></mxCell>
        <mxCell id="rs2" value="&lt;b&gt;candidates ≤ 4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;name shape (containment, initialism),&lt;br&gt;then BM25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="rs"><mxGeometry x="10" y="92" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="rs3" value="&lt;b&gt;pairwise yes/no, thinking&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one call per candidate, first “same” wins;&lt;br&gt;every decision + reason logged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="rs"><mxGeometry x="10" y="155" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="pl" value="&lt;b&gt;3c plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;claims grouped by target page;&lt;br&gt;paths for new pages (-2 on collision)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="260" height="55" as="geometry" /></mxCell>
