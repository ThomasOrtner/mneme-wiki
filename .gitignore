# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local config / secrets
.env

# Benchmark corpus is built from private project documents: local only.
bench/corpus/*
!bench/corpus/README.md
bench/results/*/*
bench/results/_superseded/
!bench/results/*/summary.md

# Spike outputs
spike/out/

# Editor
.vscode/

# draw.io editor temp files
*.dtmp

# Rendered copies of the docs (generated from the .md files)
*.pdf

# Dev vault (its own git repo, TD-16) and its inbox
examples/vault/
examples/inbox/

# Obsidian settings when docs/wiki is opened as a vault
.obsidian/

# Terms that must never reach GitHub (read by scripts/gh_guard.py; maintained by hand)
.gh-denylist
# Local Claude Code settings (.claude/settings.json is shared)
.claude/settings.local.json
